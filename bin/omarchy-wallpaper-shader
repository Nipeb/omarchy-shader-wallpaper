#!/bin/bash

# Control the animated shader wallpaper (nipe.shader-wallpaper plugin): turn it on
# or off, and cycle between styles. State is persisted so it survives a shell
# restart; the running shell is also pinged over IPC for an instant update.

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy/wallpaper-shader"
SHADERS=(aurora thunder embers nebula ink weather)
mkdir -p "$STATE_DIR"

current_shader() {
  cat "$STATE_DIR/shader" 2>/dev/null || echo "${SHADERS[0]}"
}

current_enabled() {
  cat "$STATE_DIR/enabled" 2>/dev/null || echo "0"
}

current_testing() {
  cat "$STATE_DIR/testing" 2>/dev/null || echo "0"
}

current_audio() {
  cat "$STATE_DIR/audio" 2>/dev/null || echo "1"
}

set_shader() {
  local name="$1"
  local found=0
  for s in "${SHADERS[@]}"; do [[ $s == "$name" ]] && found=1; done
  if (( ! found )); then
    echo "Unknown shader: $name (choices: ${SHADERS[*]})" >&2
    exit 1
  fi
  echo "$name" > "$STATE_DIR/shader"
  omarchy-shell -q wallpaperShader setShader "$name" >/dev/null 2>&1 || true
}

step_shader() {
  local dir="$1"
  local cur=$(current_shader)
  local idx=0
  for i in "${!SHADERS[@]}"; do [[ ${SHADERS[$i]} == "$cur" ]] && idx=$i; done
  local n=${#SHADERS[@]}
  if [[ $dir == "next" ]]; then
    idx=$(( (idx + 1) % n ))
  else
    idx=$(( (idx - 1 + n) % n ))
  fi
  set_shader "${SHADERS[$idx]}"
  echo "${SHADERS[$idx]}"
}

case "${1:-}" in
on)
  echo "1" > "$STATE_DIR/enabled"
  omarchy-shell -q wallpaperShader enable >/dev/null 2>&1 || true
  ;;
off)
  echo "0" > "$STATE_DIR/enabled"
  omarchy-shell -q wallpaperShader disable >/dev/null 2>&1 || true
  ;;
toggle)
  if [[ $(current_enabled) == "1" ]]; then
    echo "0" > "$STATE_DIR/enabled"
  else
    echo "1" > "$STATE_DIR/enabled"
  fi
  omarchy-shell -q wallpaperShader toggle >/dev/null 2>&1 || true
  ;;
next)
  echo "1" > "$STATE_DIR/enabled"
  omarchy-shell -q wallpaperShader enable >/dev/null 2>&1 || true
  step_shader next
  ;;
prev)
  echo "1" > "$STATE_DIR/enabled"
  omarchy-shell -q wallpaperShader enable >/dev/null 2>&1 || true
  step_shader prev
  ;;
set)
  [[ -n ${2:-} ]] || { echo "Usage: omarchy-wallpaper-shader set <name>" >&2; exit 1; }
  echo "1" > "$STATE_DIR/enabled"
  omarchy-shell -q wallpaperShader enable >/dev/null 2>&1 || true
  set_shader "$2"
  ;;
list)
  printf '%s\n' "${SHADERS[@]}"
  ;;
audio)
  case "${2:-}" in
  on) echo "1" > "$STATE_DIR/audio"; omarchy-shell -q wallpaperShader enableAudio >/dev/null 2>&1 || true ;;
  off) echo "0" > "$STATE_DIR/audio"; omarchy-shell -q wallpaperShader disableAudio >/dev/null 2>&1 || true ;;
  toggle|"")
    if [[ $(current_audio) == "1" ]]; then echo "0" > "$STATE_DIR/audio"; else echo "1" > "$STATE_DIR/audio"; fi
    omarchy-shell -q wallpaperShader toggleAudio >/dev/null 2>&1 || true
    ;;
  *) echo "Usage: omarchy-wallpaper-shader audio <on|off|toggle>" >&2; exit 1 ;;
  esac
  ;;
testing|--testing)
  # --testing on its own shows the weather test panel.
  arg="${2:-}"
  [[ $1 == --testing && -z $arg ]] && arg=on
  case "$arg" in
  on) echo "1" > "$STATE_DIR/testing"; omarchy-shell -q wallpaperShader enableTesting >/dev/null 2>&1 || true ;;
  off) echo "0" > "$STATE_DIR/testing"; omarchy-shell -q wallpaperShader disableTesting >/dev/null 2>&1 || true ;;
  toggle|"")
    if [[ $(current_testing) == "1" ]]; then echo "0" > "$STATE_DIR/testing"; else echo "1" > "$STATE_DIR/testing"; fi
    omarchy-shell -q wallpaperShader toggleTesting >/dev/null 2>&1 || true
    ;;
  *) echo "Usage: omarchy-wallpaper-shader testing <on|off|toggle>" >&2; exit 1 ;;
  esac
  ;;
current)
  echo "enabled=$(current_enabled) shader=$(current_shader) audio=$(current_audio) testing=$(current_testing)"
  ;;
*)
  cat >&2 <<USAGE
Usage: omarchy-wallpaper-shader <on|off|toggle|next|prev|set <name>|list|audio <on|off|toggle>|testing <on|off|toggle>|--testing|current>

  on|off|toggle       Switch the animated shader wallpaper on or off
  next|prev           Cycle to the next/previous shader style (also turns it on)
  set <name>          Jump to a specific style (also turns it on)
  list                List available shader styles
  audio <on|off|toggle>  Switch audio reactivity on or off (default: on)
  testing <on|off|toggle>  Weather test panel: buttons bottom right to try every
                      condition, time of day, wind and temperature live
  --testing           Same as: testing on
  current             Show the active style, on/off, audio and testing state
USAGE
  exit 1
  ;;
esac
